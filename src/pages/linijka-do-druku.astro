---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Strona główna",
      "item": "https://www.linijka.onl/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Linijka do druku",
      "item": "https://www.linijka.onl/linijka-do-druku/"
    }
  ]
});

const rulerSizes = [10, 20, 30];
---

<BaseLayout
  title="Linijka do druku – miarka 10 cm, 20 cm i 30 cm"
  description="Linijka do druku A4 w cm i mm z kontrolą skali 100%. Wydrukuj miarkę 10, 20 lub 30 cm i sprawdź ustawienia przed dokładnym pomiarem w domu."
  canonicalUrl="https://www.linijka.onl/linijka-do-druku/"
  schemaMarkup={breadcrumbSchema}
>
  <section class="section print-hero">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb no-print" aria-label="Nawigacja okruszkowa">
        <ol>
          <li><a href="/">Linijka online</a></li>
          <li aria-current="page">Linijka do druku</li>
        </ol>
      </nav>

      <h1>Linijka do druku</h1>
      <p class="page-intro">
        Potrzebujesz fizycznej linijki? Wydrukuj naszą linijkę w centymetrach i milimetrach. 
        Aby zachować poprawną skalę, ustaw drukowanie na <strong>100%</strong>.
      </p>
    </div>
  </section>

  <!-- Print Instructions -->
  <section class="section section-alt print-instructions no-print">
    <div class="container">
      <h2>Jak wydrukować linijkę poprawnie</h2>
      <ol class="instruction-steps">
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          </span>
          <span>Wybierz opcję drukowania (Ctrl+P lub przycisk poniżej).</span>
        </li>
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          </span>
          <span>Ustaw skalę na <strong>100%</strong>.</span>
        </li>
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </span>
          <span>Wyłącz opcję <strong>„dopasuj do strony"</strong>.</span>
        </li>
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </span>
          <span>Po wydrukowaniu sprawdź <strong>pole kontrolne 5 cm</strong> poniżej.</span>
        </li>
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </span>
          <span>Jeśli pole nie ma dokładnie 5 cm, wydrukuj ponownie z innymi ustawieniami.</span>
        </li>
      </ol>

      <div class="notice notice-warning" style="margin-top: var(--space-6);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span><strong>Ważne:</strong> Nie dopasowuj do strony. Drukuj w skali 100% — inaczej linijka będzie niepoprawna.</span>
      </div>

      <!-- Buttons -->
      <div class="print-actions">
        <button class="btn btn-primary btn-lg" id="btn-print" aria-label="Drukuj linijkę">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Drukuj linijkę
        </button>
        <button class="btn btn-secondary btn-lg" id="btn-download-pdf" aria-label="Pobierz PDF">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Pobierz PDF
        </button>
        <a href="/" class="btn btn-secondary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Wróć do linijki online
        </a>
      </div>
    </div>
  </section>

  <!-- Calibration Test Box -->
  <section class="section print-calibration" id="test-box">
    <div class="container">
      <h2 class="no-print">Pole kontrolne 5 cm</h2>
      <p class="no-print">Po wydrukowaniu zmierz to pole fizyczną linijką — powinno mieć dokładnie 5&nbsp;cm.</p>
      
      <div class="test-box-container">
        <div class="test-box" aria-label="Pole kontrolne 5 centymetrów">
          <span class="test-box-label">← 5 cm →</span>
        </div>
        <p class="test-box-note print-only">Pole powyżej powinno mieć dokładnie 5 cm. Jeśli nie — wydrukuj ponownie w skali 100%.</p>
      </div>
    </div>
  </section>

  <!-- Printable Rulers -->
  <section class="section printable-rulers" id="linijki">
    <div class="container">
      <h2 class="no-print">Linijki do wydruku</h2>
      
      {rulerSizes.map((size) => (
        <div class="print-ruler-block" id={`ruler-${size}cm`}>
          <h3 class="print-ruler-title">Linijka {size} cm</h3>
          <div class="print-ruler-svg" data-length={size}>
            <!-- SVG ruler will be generated client-side for screen, and also embedded statically for print -->
          </div>
        </div>
      ))}

      <!-- Print-only footer -->
      <div class="print-footer print-only">
        <p>linijka.onl — Linijka do druku w centymetrach i milimetrach</p>
        <p>Drukuj w skali 100%. Nie dopasowuj do strony.</p>
      </div>
    </div>
  </section>

  <!-- Preview image -->
  <section class="section section-alt no-print">
    <div class="container" style="text-align: center;">
      <img
        src="/images/printable-preview.webp"
        alt="Linijka do druku na kartce A4"
        width="500"
        height="340"
        loading="lazy"
        style="border-radius: var(--radius-lg); margin: 0 auto; box-shadow: var(--shadow-md);"
      />
      <p style="margin-top: var(--space-4); font-size: 0.875rem; color: var(--text-tertiary);">
        Podgląd linijki do druku na kartce A4
      </p>
    </div>
  </section>

  <!-- ====== TROUBLESHOOTING SECTION ====== -->
  <section class="section print-troubleshooting no-print" id="rozwiazywanie-problemow" aria-label="Rozwiązywanie problemów z wydrukiem linijki">
    <div class="container troubleshooting-container">
      <h2>Rozwiązywanie problemów z wydrukiem linijki (Troubleshooting)</h2>
      <p class="troubleshooting-lead">
        Wydrukowanie precyzyjnego przymiaru w skali 1:1 wymaga wyeliminowania automatycznego skalowania, które większość przeglądarek i sterowników drukarek stosuje domyślnie. Poniżej znajdziesz sprawdzone rozwiązania najczęstszych problemów.
      </p>

      <div class="troubleshooting-grid">
        <div class="troubleshoot-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3>1. Dlaczego linijka po wydrukowaniu jest o kilka milimetrów za krótka?</h3>
          <p>
            <strong>Przyczyna:</strong> Przeglądarka internetowa miała zaznaczoną opcję <em>„Dopasuj do obszaru zadruku”</em> (Fit to printable area) lub marginesy były ustawione na „Domyślne”. Aby zmieścić treść w marginesach arkusza, sterownik automatycznie pomniejsza dokument do ok. 93–96%.
          </p>
          <p>
            <strong>Rozwiązanie:</strong> W oknie dialogowym drukowania wybierz <strong>Skala: Niestandardowa &rarr; 100%</strong> (lub „Rozmiar rzeczywisty” / „Brak skalowania”) oraz ustaw Marginesy na <strong>„Brak”</strong> lub <strong>„Minimalne”</strong>.
          </p>
        </div>

        <div class="troubleshoot-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3>2. Instrukcja ustawień dla popularnych przeglądarek</h3>
          <ul class="browser-guide-list">
            <li>
              <strong>Google Chrome:</strong> W oknie drukowania kliknij <em>Więcej ustawień</em> &rarr; <em>Skala</em>: zmień z „Domyślna” na <strong>„Niestandardowa”</strong> i wpisz <strong>100</strong>. Marginesy: „Domyślne”.
            </li>
            <li>
              <strong>Mozilla Firefox:</strong> Rozwiń <em>Więcej ustawień</em> &rarr; odznacz pole <em>„Dopasuj do szerokości strony”</em> &rarr; wpisz w polu <em>Skala</em>: <strong>100%</strong>.
            </li>
            <li>
              <strong>Safari (macOS):</strong> W oknie systemowym upewnij się, że opcja <em>„Skaluj w celu dopasowania”</em> jest <strong>wyłączona</strong>, a wartość skali wynosi dokładnie <strong>100%</strong>.
            </li>
            <li>
              <strong>Microsoft Edge:</strong> W sekcji <em>Skalowanie</em> wybierz <strong>Rzeczywisty rozmiar</strong> (100%).
            </li>
          </ul>
        </div>

        <div class="troubleshoot-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
          </div>
          <h3>3. Szybka weryfikacja skali za pomocą karty bankowej</h3>
          <p>
            Nie masz pod ręką innej linijki, aby zmierzyć pole kontrolne 5 cm? Użyj dowolnej standardowej karty płatniczej, dowodu osobistego lub prawa jazdy (standard ISO/IEC 7810 ID-1):
          </p>
          <ul class="card-spec-list">
            <li><strong>Szerokość karty wynosi dokładnie 85,60 mm (8,56 cm)</strong>.</li>
            <li><strong>Wysokość karty wynosi dokładnie 53,98 mm (5,40 cm)</strong>.</li>
          </ul>
          <p>
            Przyłóż kartę do wydrukowanej podziałki od zera. Krawędź karty powinna wypadać dokładnie w połowie szóstego milimetra za ósmym centymetrem. Jeśli wynik się zgadza, wydruk jest w 100% dokładny.
          </p>
        </div>

        <div class="troubleshoot-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <h3>4. Wpływ papieru i mechanizmu podajnika drukarki</h3>
          <p>
            Domyślne domowe drukarki atramentowe i laserowe mogą powodować mikro-zniekształcenia w osi posuwu papieru (wzdłuż arkusza A4):
          </p>
          <ul class="card-spec-list">
            <li><strong>Gramatura papieru:</strong> Zalecamy papier o gramaturze co najmniej 80–120 g/m². Zbyt cienki papier może ulegać naciąganiu przez rolki prowadzące.</li>
            <li><strong>Wilgotność papieru:</strong> Wilgotny papier w drukarce laserowej pod wpływem wysokiej temperatury fuzera kurczy się nawet o 1–2%. Używaj suchego papieru prosto z ryzy.</li>
            <li><strong>Kierunek druku:</strong> Linijki 10 cm i 20 cm ułożone poprzecznie są najmniej podatne na błędy wałków posuwowych drukarki.</li>
          </ul>
        </div>
      </div>

      <!-- Merged Comprehensive Content from redirected /blog/linijka-do-druku/ -->
      <div class="merged-guide-content" style="margin-top: var(--space-10);">
        <h2>Praktyczny przewodnik i zasady formatu A4</h2>
        <p>
          Standardowy arkusz papieru biurowego formatu A4 (zgodny z normą ISO 216) ma precyzyjne wymiary <strong>210 × 297 mm</strong>. 
          Pozwala to bez trudu zmieścić w układzie pionowym linijkę o długości 20 cm, a po przekątnej lub w układzie dopasowanym nawet miarkę 30 cm. 
          Jednak domyślne sterowniki systemowe bardzo często próbują wymusić własne marginesy bezpieczeństwa (zazwyczaj od 5 do 15 mm z każdej strony arkusza). 
          Gdy w oknie drukowania pozostawiona jest zaznaczona opcja „Dopasuj do marginesów”, cała zawartość dokumentu ulega proporcjonalnemu skurczeniu.
        </p>

        <h3>Etapy prawidłowego przygotowania wydruku</h3>
        <div class="table-wrapper">
          <table class="guide-steps-table" aria-label="Etapy przygotowania wydruku">
            <thead>
              <tr>
                <th scope="col">Krok</th>
                <th scope="col">Czynność użytkownika</th>
                <th scope="col">Cel i znaczenie metrologiczne</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>1. Wybór podziałki</strong></td>
                <td>Wybierz rozmiar: 10 cm, 20 cm lub 30 cm</td>
                <td>Dopasowuje długość podziałki do wielkości mierzonego przedmiotu.</td>
              </tr>
              <tr>
                <td><strong>2. Konfiguracja sterownika</strong></td>
                <td>Skala 100%, brak skalowania, format A4 Portrait</td>
                <td>Eliminuje programowe pomniejszanie grafiki wektorowej przez przeglądarkę.</td>
              </tr>
              <tr>
                <td><strong>3. Weryfikacja 5 cm</strong></td>
                <td>Sprawdź pole kontrolne lub kartę płatniczą</td>
                <td>Weryfikuje poprawność pracy rolek podajnika papieru przed pomiarem.</td>
              </tr>
              <tr>
                <td><strong>4. Spokojny pomiar</strong></td>
                <td>Przyłóż krawędź papieru bezpośrednio do przedmiotu</td>
                <td>Zapobiega błędom paralaksy (odczytu pod kątem) typowym dla grubego szkła ekranu.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 style="margin-top: var(--space-8);">Kiedy papierowa linijka jest lepsza niż ekran telefonu?</h3>
        <p>
          Wydrukowany przymiar papierowy ma kilka kluczowych zalet w porównaniu z wyświetlaczem smartfona:
        </p>
        <ul class="benefit-list">
          <li><strong>Brak ryzyka porysowania ekranu:</strong> Możesz bezpiecznie mierzyć ostre metalowe śruby, gwoździe, surowe drewno czy narzędzia warsztatowe.</li>
          <li><strong>Elastyczność i pomiar po łuku:</strong> Pasek papieru można zagiąć lub owinąć wokół rury, nadgarstka czy butelki, co jest niemożliwe na sztywnym szkle telefonu.</li>
          <li><strong>Brak błędu paralaksy:</strong> Papier leży płasko na podłożu (grubość ok. 0,1 mm), podczas gdy warstwa szkła ochronnego w smartfonie (0,5–1,2 mm) powoduje pozorne przesunięcie kreski podziałki przy patrzeniu pod kątem.</li>
        </ul>

        <h3 style="margin-top: var(--space-8);">Najczęstsze pytania o linijkę do druku (FAQ)</h3>
        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-question">Czy format pliku PDF ma znaczenie dla zachowania skali?</summary>
            <div class="faq-answer">
              <p>Tak. Format PDF zachowuje wektorowe instrukcje wymiarowe zapisane w punktach typograficznych (72 pt = 1 cal). W przeciwieństwie do zwykłych plików graficznych JPG, które przeglądarka graficzna w systemie Windows często rozciąga do rozmiaru okna, plik PDF drukowany z opcją „Rozmiar rzeczywisty” gwarantuje zachowanie proporcji 1:1.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary class="faq-question">Czy linijka wydrukowana na papierze Letter będzie dokładna?</summary>
            <div class="faq-answer">
              <p>Standard amerykański US Letter ma wymiary 215,9 × 279,4 mm (jest szerszy, ale o 17,6 mm krótszy niż A4). Nasza linijka została zoptymalizowana pod europejski standard A4. W przypadku druku na papierze Letter linijka 30 cm zostanie obcięta na końcach, dlatego zawsze należy w podajniku drukarki wybrać papier A4.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary class="faq-question">Jak zminimalizować błąd wynikający z rozciągania papieru?</summary>
            <div class="faq-answer">
              <p>W drukarkach laserowych temperatura utrwalacza (tonera) przekracza 180°C, co odparowuje wilgoć z papieru i powoduje jego minimalne skurczenie (zazwyczaj poniżej 0,2–0,4 mm na 20 cm). Aby uzyskać maksymalną dokładność, odczekaj 2–3 minuty po wydrukowaniu, aż arkusz ostygnie i wyrówna wilgotność z otoczeniem.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Breadcrumb --- */
  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '›';
    margin-left: var(--space-2);
    color: var(--border-dark);
  }

  .breadcrumb a {
    color: var(--text-tertiary);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  /* --- Page Intro --- */
  .page-intro {
    font-size: 1.125rem;
    max-width: 65ch;
  }

  /* --- Instructions --- */
  .instruction-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    counter-reset: step;
  }

  .instruction-steps li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--accent-bg);
    border-radius: 50%;
    flex-shrink: 0;
    color: var(--accent);
  }

  /* --- Print Actions --- */
  .print-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* --- Test Box --- */
  .test-box-container {
    margin-top: var(--space-4);
  }

  .test-box {
    /* 5cm at 96 DPI = 5 * 37.795 ≈ 189px */
    width: 189px;
    height: 60px;
    border: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }

  .test-box-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: #000;
    font-family: var(--font-mono);
  }

  .test-box-note {
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    color: #000;
  }

  /* --- Print Rulers --- */
  .print-ruler-block {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .print-ruler-block:first-of-type {
    border-top: none;
  }

  .print-ruler-title {
    margin-top: 0;
    margin-bottom: var(--space-4);
    font-size: 1.125rem;
  }

  .print-ruler-svg {
    overflow-x: auto;
    padding: var(--space-2) 0;
    -webkit-overflow-scrolling: touch;
  }

  .print-ruler-svg :global(svg) {

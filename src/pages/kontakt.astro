---
import BaseLayout from '../layouts/BaseLayout.astro';
import { authorProfile } from '../data/author';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Strona główna",
      "item": "https://www.linijka.onl/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Kontakt",
      "item": "https://www.linijka.onl/kontakt/"
    }
  ]
});
---

<BaseLayout
  title="Kontakt – Linijka.onl"
  description="Skontaktuj się z Aleksandrem Tiedemannem, operatorem serwisu Linijka.onl, w sprawach narzędzia, treści i prywatności."
  canonicalUrl="https://www.linijka.onl/kontakt/"
  schemaMarkup={breadcrumbSchema}
>
  <section class="section contact-page">
    <div class="container contact-container">
      <nav class="breadcrumb" aria-label="Nawigacja okruszkowa">
        <ol>
          <li><a href="/">Linijka online</a></li>
          <li aria-current="page">Kontakt</li>
        </ol>
      </nav>

      <h1>Kontakt</h1>

      <div class="contact-content">
        <p class="contact-lead">
          Masz pytanie dotyczące działania linijki, kalibracji, treści lub prywatności? Napisz na adres
          <a href="mailto:info@linijka.onl?subject=Kontakt%20z%20Linijka.onl">info@linijka.onl</a>.
        </p>

        <div class="contact-card">
          <h2>Dane operatora</h2>
          <p><strong>{authorProfile.name}</strong></p>
          <p>Operator serwisu Linijka.onl</p>
          <p><a href="mailto:info@linijka.onl?subject=Kontakt%20z%20Linijka.onl">info@linijka.onl</a></p>
        </div>

        <h2>Wiadomość e-mail</h2>
        <p>
          W wiadomości opisz, czego dotyczy sprawa. W przypadku zgłoszenia błędu warto podać używane urządzenie,
          przeglądarkę i krótki opis sytuacji. Nie przesyłaj danych wrażliwych ani informacji, które nie są potrzebne
          do odpowiedzi.
        </p>

        <div class="contact-cta">
          <a href="mailto:info@linijka.onl?subject=Kontakt%20z%20Linijka.onl" class="btn btn-primary">Napisz wiadomość</a>
          <a href="/polityka-prywatnosci/" class="btn btn-secondary">Polityka prywatności</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-container {
    max-width: var(--container-lg);
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    color: var(--text-tertiary);
    font-size: 0.8125rem;
  }

  .breadcrumb li:not(:last-child)::after {
    content: '›';
    margin-left: var(--space-2);
    color: var(--border-dark);
  }

  .breadcrumb a {
    color: var(--text-tertiary);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .contact-content {
    max-width: 720px;
  }

  .contact-lead {
    margin: var(--space-4) 0 var(--space-8);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .contact-content h2 {
    margin-top: var(--space-8);
  }

  .contact-card {
    padding: var(--space-5);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .contact-card h2 {
    margin-top: 0;
  }

  .contact-card p {
    margin: var(--space-2) 0 0;
    color: var(--text-secondary);
  }

  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }
</style>

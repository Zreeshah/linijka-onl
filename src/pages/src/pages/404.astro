---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Nie znaleziono strony – Linijka.onl"
  description="Ta strona nie istnieje. Wróć do linijki online lub przejdź do poradników pomiarowych."
  canonicalUrl="https://www.linijka.onl/404/"
  noIndex={true}
>
  <section class="section error-page">
    <div class="container error-container">
      <p class="error-code" aria-hidden="true">404</p>
      <h1>Nie znaleziono strony</h1>
      <p>
        Podany adres jest nieprawidłowy albo strona została przeniesiona.
        Skorzystaj z linijki online lub przejdź do naszych poradników.
      </p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Przejdź do linijki online</a>
        <a href="/blog/" class="btn btn-secondary">Zobacz poradniki</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    min-height: 60vh;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .error-container {
    max-width: 42rem;
  }

  .error-code {
    margin: 0;
    color: var(--accent);
    font-size: clamp(4rem, 15vw, 8rem);
    font-weight: 800;
    line-height: 1;
  }

  .error-container h1 {
    margin-top: var(--space-4);
  }

  .error-container > p:not(.error-code) {
    margin: var(--space-4) auto 0;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>

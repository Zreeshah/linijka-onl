---
import BaseLayout from './BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { authorProfile } from '../data/author';

export interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  heroImage: string;
  imageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  slug: string;
  headings: Array<{ depth: number; slug: string; text: string }>;
  relatedPosts?: Array<{ slug: string; title: string; heroImage: string }>;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  imageAlt = '',
  ogTitle,
  ogDescription,
  slug,
  headings,
  relatedPosts = []
} = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const publishedDate = new Date(pubDate).toISOString().split('T')[0];
const modifiedDate = new Date(updatedDate || pubDate).toISOString().split('T')[0];
const isoUpdatedDate = updatedDate ? new Date(updatedDate).toISOString() : null;

const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('pl-PL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

// Generate dynamic JSON-LD article schema
const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": `https://www.linijka.onl${heroImage}`,
  "author": {
    "@type": "Person",
    "name": authorProfile.name,
    "url": authorProfile.url
  },
  "publisher": {
    "@type": "Organization",
    "name": "Linijka Online",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.linijka.onl/favicon.svg"
    }
  },
  "datePublished": publishedDate,
  "dateModified": modifiedDate,
  "inLanguage": "pl-PL",
  "mainEntityOfPage": `https://www.linijka.onl/blog/${slug}/`
});

// Filter headings for Table of Contents: limit to H2 only to keep TOC concise
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={`${title} | Blog Linijka.onl`}
  description={description}
  canonicalUrl={`https://www.linijka.onl/blog/${slug}/`}
  ogImage={heroImage}
  schemaMarkup={articleSchema}
>
  <div class="blog-post-container container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs no-print" aria-label="Ścieżka powrotu">
      <ol role="list">
        <li><a href="/">Strona główna</a></li>
        <li><svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg></li>
        <li><a href="/blog/">Blog</a></li>
        <li><svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <div class="blog-grid">
      <!-- Main Article -->
      <article class="blog-main">
        <header class="blog-header">
          <div class="blog-meta">
            <span class="blog-category">Poradnik Pomiaru</span>
            <span class="meta-dot">&bull;</span>
            <time datetime={new Date(pubDate).toISOString()}>Opublikowano: {formattedDate}</time>
            {formattedUpdatedDate && isoUpdatedDate && (
              <>
                <span class="meta-dot">&bull;</span>
                <time datetime={isoUpdatedDate} class="updated-date">Aktualizacja: {formattedUpdatedDate}</time>
              </>
            )}
            <span class="meta-dot">&bull;</span>
            <span class="author-label">Autor: {authorProfile.name}</span>
          </div>
          <h1 class="blog-title">{title}</h1>
          <p class="blog-lead">{description}</p>
          
          <div class="blog-hero-wrapper">
            <img class="blog-hero-image" src={heroImage} alt={imageAlt || title} />
          </div>
        </header>

        <!-- Dynamic Content Slot -->
        <div class="blog-content">
          <slot />
        </div>

        <AuthorBox />

        <!-- Call to Action Section -->
        <section class="blog-cta no-print">
          <div class="cta-card">
            <h3>Potrzebujesz dokładnego pomiaru?</h3>
            <p>Skorzystaj z naszej bezpłatnej, w pełni skalibrowanej linijki online, która dostosowuje się automatycznie do Twojego ekranu.</p>
            <a href="/" class="btn btn-primary">Uruchom linijkę online 1:1</a>
          </div>
        </section>
      </article>

      <!-- Sidebar -->
      <aside class="blog-sidebar no-print">
        <!-- Table of Contents -->
        {tocHeadings.length > 0 && (
          <div class="toc-card sticky-sidebar">
            <h2 class="toc-title">Spis treści</h2>
            <nav class="toc-nav">
              <ul>
                {tocHeadings.map((heading) => (
                  <li class={`toc-depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )}
      </aside>
    </div>

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <section class="related-posts-section no-print">
        <h2 class="section-title">Polecane artykuły</h2>
        <div class="related-grid">
          {relatedPosts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="related-card">
              <div class="related-img-wrapper">
                <img src={post.heroImage} alt={post.title} />
              </div>
              <div class="related-body">
                <h3>{post.title}</h3>
                <span class="related-more">Czytaj dalej &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style is:global>
  /* Hide unsupplied photograph placeholders for now */
  .blog-content .content-figure,
  .blog-content .placeholder-box {
    display: none !important;
  }
  .blog-content .content-figure figcaption {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    font-style: italic;
    line-height: 1.5;
  }
  .blog-content .reference-table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
  }
</style>
